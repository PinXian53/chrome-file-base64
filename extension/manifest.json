{
  "manifest_version": 3,
  "name": "File ⇄ Base64",
  "short_name": "File Base64",
  "version": "1.0.0",
  "description": "離線將檔案轉成 Base64、或從 Base64 還原檔案。支援分割多份、Data URI、純 Base64，資料不離開你的電腦。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "File ⇄ Base64",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "開啟 File ⇄ Base64"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
